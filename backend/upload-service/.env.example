# Chạy service bằng Docker Compose (hostname là tên service trong compose.yml)
RABBITMQ_URL=amqp://music:musicpass@rabbitmq:5672

# Chạy service trực tiếp trên máy (npm start) thì trỏ vào port public của rabbitmq
# RABBITMQ_URL=amqp://music:musicpass@localhost:5672

# Phải trùng với account-service/.env thì mới verify được token phát hành từ đó.
JWT_SECRET=12345678912345678912345678912345
JWT_ISSUER=account-service
JWT_AUDIENCE=listener
